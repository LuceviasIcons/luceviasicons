{
  "name": "@lucevias/core",
  "version": "0.2.0",
  "description": "LUCEVIAS — raw SVG assets and icon metadata. The source of truth for every LUCEVIAS package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "svg",
    "assets"
  ],
  "exports": {
    "./icons.json": "./assets/icons.json",
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuceviasIcons/luceviasicons.git",
    "directory": "packages/core"
  }
}
