    "icon-set",
    "svg",
    "svg-icons",
    "icon-library",
    "open-source-icons",
    "iconography",
    "ui-icons",
    "design-system",
    "assets",
    "icon-metadata"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuceviasIcons/luceviasicons.git",
    "directory": "packages/core"
  }
}
