{
  "name": "icon-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons:optimize": "svgo -f src/icons/svg -o src/icons/svg --config svgo.config.mjs",
    "a11y": "node scripts/a11y.mjs",
    "pkg:generate": "node scripts/build-package.mjs",
    "pkg:build": "npm run pkg:generate && cd packages/icons && npx vite build && npx tsc -p tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "oxlint": "^1.75.0",
    "shadcn": "^4.16.1",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
