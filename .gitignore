# The source of truth is the SVG in packages/core/svg, derivatives are not committed.
packages/icons/src

# The exception is packages/core/assets/icons.json: the site installs @lucevias/core
# straight from this repository, and npm, when installing from git, takes only what
# is actually committed and does not run generators. The file is built by
# build-core.mjs — do not edit by hand.

